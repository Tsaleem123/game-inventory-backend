# Copy this file to ".env" in this same folder (GameInventory/) and fill in the values.
# See README.md, step 6, for details. Never commit your real .env.

# --- Database: pick ONE, keep the single quotes ---
# macOS (Docker):
ConnectionStrings__DefaultConnection='Server=localhost,1433;Database=GameInventory;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True'
# Windows (LocalDB):
# ConnectionStrings__DefaultConnection='Server=(localdb)\MSSQLLocalDB;Database=GameInventory;Trusted_Connection=True;TrustServerCertificate=True'

# --- Login tokens (secret must be 32+ characters) ---
JwtSettings__Secret=
JwtSettings__Issuer=GameInventoryAPI
JwtSettings__Audience=GameInventoryClient

# --- Email (needed for signup confirmation and password reset) ---
EmailSettings__SenderEmail=
EmailSettings__Password=
EmailSettings__SmtpServer=smtp.gmail.com

# --- IGDB / Twitch developer app ---
IGDB_Client=
IGDB_Secret=

# --- Local server ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5202

# --- Allowed frontend origins (comma-separated, no spaces, no trailing slashes) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
